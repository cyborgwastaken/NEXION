.keypad-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.keypad-panel {
    width: 260px;
    background-color: rgb(10, 10, 10);
    border-width: 2px;
    border-color: rgb(0, 255, 255);
    padding: 14px;
    align-items: center;
}

.keypad-title {
    color: rgb(0, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.keypad-display {
    color: rgb(0, 255, 255);
    font-size: 22px;
    letter-spacing: 6px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.keypad-status {
    color: rgb(255, 0, 255);
    font-size: 12px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    min-height: 16px;
}

.keypad-grid {
    width: 100%;
}

.keypad-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.keypad-btn {
    width: 64px;
    height: 48px;
    background-color: rgb(5, 0, 10);
    color: rgb(0, 255, 255);
    border-width: 1px;
    border-color: rgb(0, 255, 255);
    font-size: 16px;
}

.keypad-btn:hover {
    background-color: rgb(0, 60, 60);
}

.keypad-btn-alt {
    color: rgb(255, 0, 255);
    border-color: rgb(255, 0, 255);
}

.keypad-btn-alt:hover {
    background-color: rgb(60, 0, 60);
}
